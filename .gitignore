# ==========================================
# Credenciais e Segredos (CRÍTICO - NUNCA SUBIR)
# Pega .env em qualquer pasta (clientes/*/.env, Evolution_Global/.env) e variantes.
# ==========================================
.env
.env.*
credentials.json
# Exceção: o MOLDE do template é versionado (só tem placeholders, sem segredo real).
!clientes/_template/.env

# ==========================================
# Banco de Dados Local (SQLite) — em qualquer cliente
# ==========================================
banco_dados/
*.db
*.db-journal
*.db-wal
*.db-shm

# ==========================================
# Dados REAIS de cliente (nomes, agendas, telefones, chat ids, mensagens).
# Ficam só no servidor, como o .env. O molde (_template) continua versionado.
# ==========================================
clientes/*/dados.json
!clientes/_template/dados.json

# ==========================================
# Fotos de profissionais (dados de cliente, não código) — em qualquer pasta
# ==========================================
fotos/

# ==========================================
# Pasta do modelo antigo (histórico + segredos antigos) — não versionar
# ==========================================
Arquivos_antigos/

# ==========================================
# Dependências do Node.js
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Configuração do Docker Local
# ==========================================
.docker/
/DATA/.docker/

# ==========================================
# Sistema Operacional e Editores
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db