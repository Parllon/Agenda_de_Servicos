# .env.barbearia.exemplo — referência das chaves do tema/negócio.
#
# Jeito mais seguro de criar o de verdade (garante TODAS as chaves que o app espera):
#   1) copie seu .env atual:   cp .env .env.barbearia
#   2) no .env.barbearia, ajuste/adicione as 5 linhas do bloco "TEMA + IDENTIDADE"
#      abaixo (TEMA, NEGOCIO_NOME, NEGOCIO_SUBTITULO, NEGOCIO_CIDADE, SEED).
# (A porta NÃO fica aqui — fica no docker-compose.barbearia.yml: 8091.)

# ===== TEMA + IDENTIDADE (o que muda por cliente) =====
TEMA=barbearia                 # manicure | barbearia
NEGOCIO_NOME=Navalha de Ouro
NEGOCIO_SUBTITULO=Barbearia
NEGOCIO_CIDADE=Rio de Janeiro
SEED=barbearia                 # qual conjunto de dados o seed.js popula

# ===== Servidor =====
PORT=3000
GOOGLE_CREDENTIALS_PATH=./credentials.json
TIMEZONE=America/Sao_Paulo
TIMEZONE_OFFSET=-03:00

# ===== Agenda / horários =====
EXPEDIENTE_INICIO=9
EXPEDIENTE_FIM=20
FOLGAS=0
SLOT_STEP_MIN=30               # passo entre horários (30 = de meia em meia hora)
JANELA_DIAS=30
ANTECEDENCIA_MIN=60

# ===== WhatsApp (OPCIONAL no teste) =====
# Sem Evolution neste compose, o envio simplesmente não acontece (não quebra nada).
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=coloque_sua_chave
WHATSAPP_INSTANCE=barbearia
LEMBRETE_VESPERA_HORA=21

# ===== Domínio (vazio em teste local) =====
CORS_ORIGIN=
LANDING_URL=
