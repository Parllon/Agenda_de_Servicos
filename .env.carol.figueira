
# # ===== TEMA + IDENTIDADE (o que muda por cliente) =====
# TEMA=barbearia                 # manicure | barbearia
# NEGOCIO_NOME=Navalha de Ouro
# NEGOCIO_SUBTITULO=Barbearia
# NEGOCIO_CIDADE=Rio de Janeiro
# SEED=barbearia                 # qual conjunto de dados o seed.js popula

# ===== TEMA + IDENTIDADE (o que muda por cliente) =====
TEMA=manicure           # manicure | barbearia
NEGOCIO_NOME=Carol Figueira
NEGOCIO_SUBTITULO=Manicure
NEGOCIO_CIDADE=Rio de Janeiro
SEED=carol              # qual conjunto de dados o seed.js popula

# ==========================================
# Configurações da API e Google
# ==========================================
PORT=3000
GOOGLE_CREDENTIALS_PATH=./credentials.json
TIMEZONE=America/Sao_Paulo
JANELA_DIAS=30
LEMBRETE_VESPERA_HORA=21

# ==========================================
# Configurações do Stack Evolution API
# ==========================================
# Crie uma senha forte (sem espaços ou caracteres especiais complexos)
EVOLUTION_API_KEY=e01a08dc6e4ca1c13d1d9f91
WHATSAPP_INSTANCE=manicure

# ==========================================
# Configurações do Gateway de WhatsApp
# ==========================================
# Deixe como 'zapi' APENAS até você escanear o QR Code no painel da Evolution.
# Depois que conectar, mude a linha abaixo para: WHATSAPP_PROVIDER=evolution
WHATSAPP_PROVIDER=evolution
CONFIG_SESSION_PHONE_VERSION=2.3000.1040656236

# A URL aponta para o nome do container no docker-compose.full.yml
WHATSAPP_API_URL=http://evolution-api:8080

# O Token DEVE ser exatamente o mesmo valor que você colocou no EVOLUTION_API_KEY
WHATSAPP_API_TOKEN=e01a08dc6e4ca1c13d1d9f91

LANDING_URL=
CORS_ORIGIN=

# Intervalo de tempo para comportamento humano.

ENVIO_DELAY_MIN_MS=1000
ENVIO_DELAY_MAX_MS=3000
ENVIO_LOTE_MIN_MS=5000
ENVIO_LOTE_MAX_MS=10000

# Horário de atendimento (hora cheia, 0-23)
EXPEDIENTE_INICIO=9
EXPEDIENTE_FIM=19
SLOT_STEP_MIN=30

# Dias de folga (0=dom, 1=seg ... 6=sáb). Separados por vírgula.
# Vazio = abre todos os dias (só pra teste). Ex.: FOLGAS=0 fecha domingo.
FOLGAS=0

