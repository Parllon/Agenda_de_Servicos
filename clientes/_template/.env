# .env — CONFIGURAÇÃO DO CLIENTE (infra + tema + segredos). SEM dados de negócio:
# nome, serviços e preços ficam no dados.json. Aqui só o que é de máquina.
#
# Para um cliente novo: copie a pasta _template, renomeie, e ajuste os 4 campos
# do topo (CLIENTE, PORTA_EXTERNA, TEMA, WHATSAPP_INSTANCE) + o dados.json.

# ===== Identidade da instância =====
CLIENTE=cliente_exemplo          # usado só no nome dos containers (precisa ser único)
PORTA_EXTERNA=3001               # porta externa única -> plugue no Cloudflare Tunnel
TEMA=tema_1                       # tema_1..tema_8 (ver novo-cliente.sh para descrição)
PERFIL_PROFISSIONAL=profissional  # profissional | barbeiro | terapeuta | cabeleireiro | designer | tatuador | especialista

# ===== Caminhos (montados pelo compose; normalmente não mexer) =====
CAMINHO_DADOS_JSON=/cliente/dados.json
DB_PATH=/data/agendamentos.db
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ===== Fuso =====
TIMEZONE=America/Sao_Paulo
TIMEZONE_OFFSET=-03:00

# ===== Expediente / horários =====
EXPEDIENTE_INICIO=9
EXPEDIENTE_FIM=19
FOLGAS=0
SLOT_STEP_MIN=30
JANELA_DIAS=30
# Antecedência mínima para o cliente marcar (minutos). Ex: 120 = só horários a partir de agora+2h. 0 desliga a regra.
ANTECEDENCIA_AGENDAMENTO_MIN=120
ANTECEDENCIA_MIN=60

# ===== WhatsApp (Evolution GLOBAL, compartilhada na rede agenda-net) =====
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://evolution-api:8080
WHATSAPP_API_TOKEN=CHAVE_MESTRE_DA_EVOLUTION   # MESMA chave do Evolution_Global/.env (o codigo le esta variavel)
WHATSAPP_INSTANCE=whatsapp_cliente_exemplo   # instância única deste cliente na Evolution

# ----- Modo do WhatsApp -----
# proprio (padrão) = este salão usa o PRÓPRIO número (WHATSAPP_INSTANCE acima).
# central          = um único número do SlotMe envia para todos os salões.
# Ausente/proprio = comportamento atual (nada muda).
WHATSAPP_MODE=proprio
# Instância central na Evolution (a MESMA p/ todos os clientes em modo central).
# Só é usada quando WHATSAPP_MODE=central; ignorada no modo proprio.
WHATSAPP_INSTANCE_CENTRAL=slotme_central
# Prefixa "[Label] " na mensagem p/ o cliente saber de qual salão é o aviso.
# Recomendado no modo central (todos recebem do mesmo número). true | false
WHATSAPP_PREFIXO_NOME=false
# Texto do prefixo. Vazio = usa o slug CLIENTE (lá no topo do arquivo).
WHATSAPP_PREFIXO_LABEL=

# ----- Aviso à dona/salão por WhatsApp -----
# Instância (número) DEDICADA que envia os avisos internos à dona ("fulano marcou
# tal horário"), em paralelo ao Telegram. Pareie um número próprio na Evolution.
# Vazio = usa a mesma instância de envio aos clientes. O número de destino da dona
# fica no dados.json (negocio.whatsapp_aviso); vazio lá = não envia por WhatsApp.
WHATSAPP_INSTANCE_AVISOS=

LEMBRETE_VESPERA_HORA=21

# ===== Telegram (avisos ao salão/profissionais — OPCIONAL) =====
# Crie 1 bot no @BotFather e cole o token aqui (o MESMO para todos os clientes).
# Os chat ids (do salão e de cada profissional) ficam no dados.json.
# Deixe vazio para desligar os avisos por Telegram deste cliente.
TELEGRAM_BOT_TOKEN=

# ===== Domínio =====
CORS_ORIGIN=https://cliente.seudominio.com.br
LANDING_URL=https://cliente.seudominio.com.br
