# .env — CONFIGURAÇÃO DO CLIENTE (infra + tema + segredos). SEM dados de negócio:
# nome, serviços e preços ficam no dados.json. Aqui só o que é de máquina.
#
# Para um cliente novo: copie a pasta _template, renomeie, e ajuste os 4 campos
# do topo (CLIENTE, PORTA_EXTERNA, TEMA, WHATSAPP_INSTANCE) + o dados.json.

# ===== Identidade da instância =====
CLIENTE=cliente_exemplo          # usado só no nome dos containers (precisa ser único)
PORTA_EXTERNA=3001               # porta externa única -> plugue no Cloudflare Tunnel
TEMA=manicure                    # manicure | barbearia

# ===== Caminhos (montados pelo compose; normalmente não mexer) =====
CAMINHO_DADOS_JSON=/cliente/dados.json
DB_PATH=/data/agendamentos.db
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ===== Fuso =====
TIMEZONE=America/Sao_Paulo
TIMEZONE_OFFSET=-03:00

# ===== Expediente / horários =====
EXPEDIENTE_INICIO=9
EXPEDIENTE_FIM=19
FOLGAS=0
SLOT_STEP_MIN=30
JANELA_DIAS=30
ANTECEDENCIA_MIN=60

# ===== WhatsApp (Evolution GLOBAL, compartilhada na rede agenda-net) =====
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHAVE_MESTRE_DA_EVOLUTION
WHATSAPP_INSTANCE=whatsapp_cliente_exemplo   # instância única deste cliente na Evolution
LEMBRETE_VESPERA_HORA=21

# ===== Domínio =====
CORS_ORIGIN=https://cliente.seudominio.com.br
LANDING_URL=https://cliente.seudominio.com.br
